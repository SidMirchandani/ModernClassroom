# Copy to .env.local and fill in. Never commit .env.local.

# Supabase — project settings → API. The publishable (anon) key is safe in the
# browser; every table is behind row-level security.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Gemini — used only by the curriculum import route, server-side.
GEMINI_API_KEY=
# Optional: only the first model tried. Leave unset and the server picks a
# current one from Google's catalogue, falling through when one is busy.
# GEMINI_MODEL=

# Supabase service role — server only, never NEXT_PUBLIC_. Used for one table:
# google_connections, which holds teachers' Google refresh tokens and which no
# signed-in caller can read. Project settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth "Web application" client for "Connect Google Classroom".
# Authorised redirect URIs: http://localhost:5000/api/google/callback and
# https://<your site>/api/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google OAuth "Desktop app" client — only the M1 spike script uses these
# (scripts/spike-classroom.mjs). Test with a personal Gmail, never a school one.
# SPIKE_GOOGLE_CLIENT_ID=
# SPIKE_GOOGLE_CLIENT_SECRET=

# The public origin, used for canonical URLs, Open Graph and the sitemap.
# Leave unset in development.
NEXT_PUBLIC_SITE_URL=
