# Copy to .env.local and fill in. Never commit .env.local.

# Supabase — project settings → API. The publishable (anon) key is safe in the
# browser; every table is behind row-level security.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Gemini — used only by the curriculum import route, server-side.
GEMINI_API_KEY=
# Optional: only the first model tried. Leave unset and the server picks a
# current one from Google's catalogue, falling through when one is busy.
# GEMINI_MODEL=

# The public origin, used for canonical URLs, Open Graph and the sitemap.
# Leave unset in development.
NEXT_PUBLIC_SITE_URL=
